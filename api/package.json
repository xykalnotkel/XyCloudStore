{
  "name": "xycloud-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute xycloud --local --file=./schema.sql",
    "db:migrate": "wrangler d1 migrations apply xycloud --remote",
    "db:migrate:local": "wrangler d1 migrations apply xycloud --local",
    "db:check": "python3 ../tools/cek_skema_d1.py",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.133.0"
  },
  "type": "module"
}
